# Runtime
NODE_ENV=development
PORT=5001
MONGODB_URI=replace-with-your-mongodb-connection-string

# Authentication. Use long, random values; production startup rejects weak or missing effective secrets.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=30d
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Allowed browser origin. In development localhost:5173 and localhost:3000 are also allowed.
FRONTEND_URL=http://localhost:5173
# Optional development tunnel origin. Not used as a production origin.
NGROK_URL=

# Optional SMTP delivery. Set the required host, user, and password together to enable SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Optional Google OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token

# Optional Cloudinary document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# Optional salary and payroll controls
SALARY_ENCRYPTION_KEY=replace-with-a-secure-32-byte-key
PAYROLL_DISBURSE_SECRET=replace-with-payroll-confirmation-secret
PAYSLIP_COMPANY_ADDRESS=
PAYSLIP_COMPANY_PHONE=
PAYSLIP_COMPANY_EMAIL=

# Optional seed configuration. Never use a default seed password in production.
FINANCE_MANAGER_SEED_EMAIL=
FINANCE_MANAGER_SEED_PASSWORD=replace-with-a-unique-seed-password
SEED_PAYROLL_SAMPLE=0

# Optional business thresholds and targets
CEO_REQUISITION_SALARY_THRESHOLD=
CEO_OFFER_SALARY_THRESHOLD=
CEO_RECRUITMENT_BUDGET_TARGET=
CEO_HIRING_TARGET_YEAR=
CEO_OPEN_REQUISITIONS_TARGET=
CEO_DIVERSITY_BENCHMARK_PCT=

# Legacy alias used only by a few diagnostic scripts; prefer MONGODB_URI.
MONGO_URI=
